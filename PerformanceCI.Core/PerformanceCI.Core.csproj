<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>PerformanceCI.Core</PackageId>
    <Version>2.0.0</Version>
    <Authors>Divide-By-Zero-Solutions</Authors>
    <Company>Divide-By-Zero-Solutions</Company>
    <Description>Zero-allocation performance-gate attributes, scoped watchdogs, heavy-event bus, and CI report writers for PerformanceCI.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>performance;benchmark;gates;assertions;profiling;ci</PackageTags>
    <PackageProjectUrl>https://github.com/Divide-By-Zero-Solutions/PerformanceCi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Divide-By-Zero-Solutions/PerformanceCi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageOutputPath>..\bin\Release</PackageOutputPath>
    <NoWarn>$(NoWarn);SYSLIB1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PerformanceCI.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>